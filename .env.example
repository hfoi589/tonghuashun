# Create the real file with ./scripts/setup-admin.sh .env (mode 0600).
# It writes only the following secrets and never stores THS application credentials.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Required when CORE_METRICS_TRANSPORT or FUND_FLOW_TRANSPORT is shadow/direct.
# Generate a URL-safe base64 Fernet key locally and keep the real value private.
THS_SESSION_ENCRYPTION_KEY=
