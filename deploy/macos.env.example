# Used with: docker --context orbstack compose --env-file .env --env-file deploy/macos.env -f deploy/compose.yml up -d --build
# Both Android VMs run natively on the Apple Silicon Mac; they are not Dockerized.
CORE_ADB_SERIAL=emulator-5556
CORE_FRIDA_SERVER_ENDPOINT=host.docker.internal:27043
FUND_ADB_SERIAL=emulator-5554
FUND_FRIDA_SERVER_ENDPOINT=host.docker.internal:27042
# Legacy single-device compatibility variables are intentionally left unset.
ADB_SERIAL=
ADB_SERVER_SOCKET=tcp:host.docker.internal:5037
ADB_CONNECT=0
ADMIN_PASSWORD_FILE=/data/admin/password.hash
# FastAPI serves the React site and API together over local HTTP.
APP_PORT=8001
ADMIN_COOKIE_SECURE=0
FRIDA_SERVER_ENDPOINT=
# Market transport modes: frida (default), shadow, or direct.
CORE_METRICS_TRANSPORT=frida
FUND_FLOW_TRANSPORT=frida
# The local broker is only reachable from the API container. Keep its random
# token only in the mode-0600 root .env; this required empty assignment is a
# non-secret placeholder and must never contain a real value.
THS_DEVICE_LIFECYCLE_URL=http://host.docker.internal:18765
THS_DEVICE_LIFECYCLE_TOKEN=
THS_DEVICE_LIFECYCLE_TIMEOUT_SECONDS=5
# Required when either transport is shadow/direct. Generate a Fernet key locally;
# never commit the real value.
THS_SESSION_ENCRYPTION_KEY=
THS_SESSION_ROOT=/data/admin/ths-sessions
SYMBOL_CATALOG_PATH=/data/market/symbol-catalog.db
SYMBOL_CATALOG_MAX_AGE_SECONDS=604800
SYMBOL_CATALOG_REFRESH_HOUR=16
SYMBOL_CATALOG_REFRESH_MINUTE=20
PUBLIC_MARKET_TIMEOUT_SECONDS=8
MARKET_DIRECT_ENRICHMENT=1
MARKET_DIRECT_ENRICHMENT_TTL_SECONDS=15
CORE_WARM_CONNECTION_MAX_IDLE_SECONDS=25
