# Used with: docker compose --env-file deploy/macos.env -f deploy/compose.yml up -d --build
# The Android VM runs natively on the Apple Silicon Mac; it is not Dockerized.
ADB_SERIAL=emulator-5554
ADB_SERVER_SOCKET=tcp:host.docker.internal:5037
ADB_CONNECT=0
ADMIN_PASSWORD_FILE=/data/admin/password.hash
# FastAPI serves the React site and API together over local HTTP.
APP_PORT=8000
ADMIN_COOKIE_SECURE=0
FRIDA_SERVER_ENDPOINT=host.docker.internal:27042
